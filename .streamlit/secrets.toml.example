# Copy to .streamlit/secrets.toml for local Streamlit runs (file is gitignored).
# On Streamlit Community Cloud, paste equivalent keys in App → Settings → Secrets.

LLM_PROVIDER = "groq"
LLM_API_KEY = "gsk_your_key_here"
GROQ_API_KEY = "gsk_your_key_here"
LLM_MODEL = "llama-3.3-70b-versatile"
LLM_TEMPERATURE = "0.3"
LLM_MAX_RETRIES = "1"

DATA_PATH = "data/processed/restaurants.parquet"
MAX_CANDIDATES = "30"
BUDGET_LOW_MAX = "500"
BUDGET_MEDIUM_MAX = "1500"
