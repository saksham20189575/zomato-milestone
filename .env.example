# Processed restaurant data path
DATA_PATH=data/processed/restaurants.parquet

# Budget band thresholds (cost for two, INR)
BUDGET_LOW_MAX=500
BUDGET_MEDIUM_MAX=1500

# Max candidates sent to LLM
MAX_CANDIDATES=30

# Groq LLM settings (https://console.groq.com)
LLM_PROVIDER=groq
LLM_API_KEY=
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=1

# Comma-separated browser origins (Vercel + local dev). Use * for preview deploys:
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://*.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
